# Robby web application (FastAPI under Uvicorn), behind nginx.
# Install: deploy/install.sh copies this to /etc/systemd/system/robby.service.
[Unit]
Description=Robby (Robson classification and readiness) web application
After=network.target postgresql@16-robby.service
Requires=postgresql@16-robby.service

[Service]
Type=simple
User=robby
Group=robby
WorkingDirectory=/srv/robby/robby/app
EnvironmentFile=/etc/robby/robby.env
ExecStart=/srv/robby/robby/app/.venv/bin/uvicorn robby.main:create_app --factory \
    --host 127.0.0.1 --port 8170 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

# Hardening: the service can write only its artefact directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/robby/artefacts
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
