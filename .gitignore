# data (only reference tables may be committed)
**/data/*
!**/data/reference/
# experiment tracking and build outputs
mlruns/
reports/
# model artefacts stay local, except the packaged model the app and the API load
**/artefacts/*
!ML/artefacts/packaged/
ML/artefacts/packaged/*
!ML/artefacts/packaged/readiness-v1.0/
# python tooling
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# app settings with local credentials and the secret key
app/.env

# local feed token for the OpenClinic demo helper
app/.oc-token

# raw survey exports dropped in the repo root (patient-level data)
/*.xlsx

# browser check screenshots (app/scripts/browser_check.py)
app/browser-check/
