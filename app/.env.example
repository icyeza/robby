# Copy to app/.env (git-ignored) and fill in. Any variable can instead be set in the environment.
ROBBY_DATABASE_URL=postgresql+psycopg://robby:CHANGE-ME@localhost:5432/robby
# Server used by the test suite; the database name is only a prefix for throwaway databases.
ROBBY_TEST_DATABASE_URL=postgresql+psycopg://robby:CHANGE-ME@localhost:5432/robby_test
# At least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROBBY_SECRET_KEY=CHANGE-ME
# false only for local http development
ROBBY_SECURE_COOKIES=false
# Optional, with defaults:
# ROBBY_ARTEFACT_DIR=artefacts
# ROBBY_RULE_SET_PATH=<robson_v1.0.yaml shipped in robson_engine>
# ROBBY_SESSION_IDLE_MINUTES=30
# ROBBY_SESSION_ABSOLUTE_HOURS=12
# ROBBY_TIMEZONE=Africa/Kigali
# ROBBY_DEMO=false
